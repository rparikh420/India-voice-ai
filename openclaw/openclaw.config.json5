// OpenClaw starter config — curated personal assistant
// Target: ~/.openclaw/openclaw.json  (JSON5: comments and trailing commas are fine)
//
// Do NOT copy this over an existing config blindly. Merge section by section, then run:
//   openclaw security audit
//   openclaw gateway restart
//
// Replace every ALL_CAPS placeholder before use.

{
  // ─────────────────────────────────────────────────────────────────────────
  // Gateway — locked down by default
  // ─────────────────────────────────────────────────────────────────────────
  gateway: {
    bind: "loopback",              // 127.0.0.1 only; never expose directly
    port: 18789,
    auth: {
      mode: "token",               // defense in depth even on loopback
      // token: set via `openclaw config set gateway.auth.token <value>`
      //        keep it OUT of any file you commit
    },
    controlUi: {
      // CVE-2026-25253 (CVSS 8.8, missing Origin validation -> token
      // exfiltration -> RCE) was fixed in v2026.1.29. The residual: current
      // validation accepts a request when BOTH origin and request are
      // loopback, so any page served from another localhost port — a dev
      // server, a stray `python -m http.server` — presents a loopback origin
      // and passes. Setting this explicitly closes that.
      // Its absence is itself a critical audit finding
      // (gateway.control_ui.allowed_origins_required).
      allowedOrigins: ["http://127.0.0.1:18789"],
    },
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Secrets come from the environment, never inline
  // ─────────────────────────────────────────────────────────────────────────
  env: {
    // OPENROUTER_API_KEY, DISCORD_BOT_TOKEN, GITHUB_TOKEN are read from the
    // daemon's environment. On macOS set them in the launchd unit or a
    // sourced profile — see bootstrap.sh.
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Models — tiered routing on OpenRouter
  // Refs follow openrouter/<provider>/<model>
  // ─────────────────────────────────────────────────────────────────────────
  models: {
    aliases: {
      smart: "openrouter/moonshotai/kimi-k2.6",            // main agentic loop
      backup: "openrouter/moonshotai/kimi-k2.5",           // bundled fallback
      // NOT gemini-3.5-flash — at ~$1.50/$9.00 per M tokens it is 2.5x the
      // input and 2.6x the output price of Kimi K2.6. "Flash" is a latency
      // name, not a price one. Lite is the actual cheap tier.
      cheap: "openrouter/google/gemini-3.5-flash-lite",    // heartbeat, triage, summaries
    },
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Agents — three trust tiers. See README "Architecture".
  // ─────────────────────────────────────────────────────────────────────────
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: {
        primary: "openrouter/moonshotai/kimi-k2.6",
        fallback: ["openrouter/moonshotai/kimi-k2.5", "openrouter/auto"],
      },

      // Heartbeat lives HERE, not at the top level.
      // Trap: if any entry under agents.entries defines its own `heartbeat`
      // block, ONLY those agents run heartbeats. Leaving it here alone keeps
      // it on the default (main) agent.
      heartbeat: {
        every: "30m",
        target: "discord",
        to: "channel:YOUR_BRIEF_CHANNEL_ID",   // default is "none" = run but don't deliver
        isolatedSession: true,                 // ~2-5K tokens/run instead of ~100K
        lightContext: true,
        // Without an explicit model here, heartbeats run on the agent's
        // primary (Kimi K2.6) — not the cheap tier.
        model: "openrouter/google/gemini-3.5-flash-lite",
        // The field is `timezone`, not `tz`. start and end must differ, or the
        // window is zero-width and every run counts as outside it.
        activeHours: { start: "08:00", end: "22:00", timezone: "America/New_York" },
      },
    },

    entries: {
      // ── main: the assistant you talk to ──────────────────────────────────
      // Reads calendar/notes, talks on Discord, delegates real work.
      // No shell. This is the agent with your memory in it.
      main: {
        workspace: "~/.openclaw/workspace",
        model: { primary: "openrouter/moonshotai/kimi-k2.6" },
        tools: {
          profile: "messaging",
          exec: { security: "deny" },
          // MCP isolation is enforced HERE, via tools.allow globs — there is
          // no `agents.entries.<id>.mcp.servers` key. Without these globs
          // every agent sees every registered server, which is precisely the
          // isolation failure the three-agent split exists to prevent.
          allow: ["calendar__*", "notion__*", "files__*"],
        },
        memory: {
          search: {
            rememberAcrossConversations: true,
            queryMode: "recent",
            maxSummaryChars: 220,
            promptStyle: "balanced",
          },
        },
      },

      // ── triage: reads untrusted content ──────────────────────────────────
      // Email and web land here FIRST. Cannot execute. Cannot message out.
      // Its output is data for `main` to act on, never instructions to follow.
      triage: {
        workspace: "~/.openclaw/workspace-triage",
        // TENSION — read before changing anything about this agent.
        // Highest-frequency job in the setup (~213 runs/mo), so price matters
        // more here than anywhere else. But OpenClaw's own security guidance
        // says NOT to use weaker/smaller tiers for tool-enabled agents or
        // untrusted inboxes, and `models.small_params` is a critical audit
        // check. This is the cheapest model in the config reading the most
        // hostile input.
        //
        // Accepted because the defense here is the POLICY, not the model's
        // judgement: exec denied, no `message` tool, gmail-only allowlist, no
        // cross-conversation memory. A fully persuaded triage still cannot
        // act — it can only write a summary.
        //
        // The residual risk is that summary: it flows to `main`, so a
        // persuaded triage carries the attack forward one hop. Summarization
        // blunts this (the attacker loses control of exact tokens) but does
        // not eliminate it.
        //
        // CONDITION: if you ever widen this agent's tools, upgrade the model
        // in the same commit.
        model: { primary: "openrouter/google/gemini-3.5-flash-lite" },
        tools: {
          profile: "messaging",
          exec: { security: "deny" },
          deny: ["message", "browser"],   // no outbound messaging, no live browsing
          allow: ["gmail__*"],            // gmail only — see main's note on tools.allow
        },
        memory: { search: { rememberAcrossConversations: false } },
      },

      // ── opencode: external coding harness via ACP ────────────────────────
      // NOT an OpenClaw agent in the usual sense — OpenClaw is only the
      // control plane here. OpenCode runs as its own CLI on the host with its
      // own model config, its own auth, and its own permission model.
      //
      // READ THIS: OpenClaw's sandbox does NOT wrap ACP execution. The
      // `sandbox` block that protects `dev` does nothing for this agent.
      // Containment comes from `cwd` alone — which is why every session is
      // pointed at a throwaway git worktree (see worktree.sh) rather than a
      // live working copy.
      opencode: {
        runtime: {
          type: "acp",
          acp: {
            agent: "opencode",
            backend: "acpx",
            mode: "persistent",       // survives gateway restarts
            // Default parent dir for sessions. worktree.sh overrides this
            // per-spawn with --cwd pointing at an isolated worktree.
            cwd: "~/code/worktrees",
          },
        },
      },

      // ── dev: does the work, sandboxed ────────────────────────────────────
      // Shell allowed but contained. No email, no calendar, no personal memory.
      dev: {
        workspace: "~/code",
        model: { primary: "openrouter/moonshotai/kimi-k2.6" },
        sandbox: {
          mode: "all",             // every session contained (needs Docker)
          workspaceAccess: "rw",   // mounts workspace at /workspace
          // Third axis, easy to miss: default is "agent", which means every
          // dev session shares ONE container. "session" isolates per session.
          // Never "shared".
          scope: "session",
          // Docker sandboxes default to network: "none", plus read-only root
          // and all caps dropped. So `npm install` and `git push` fail inside
          // dev. That's expected, not a bug — grant network deliberately for
          // the specific jobs that need it.
        },
        tools: {
          profile: "full",
          exec: { security: "allow" },   // safe only because of the sandbox above
          allow: ["github__*"],
          // Sandboxed agents need MCP tools re-admitted inside the sandbox.
          // Without this, github__* is invisible to dev even though
          // `openclaw mcp probe github` reports a healthy server.
          sandbox: { tools: { alsoAllow: ["github__*"] } },
        },
        memory: { search: { rememberAcrossConversations: false } },
      },
    },
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Global tool policy — the floor. Per-agent settings can narrow, not widen.
  // ─────────────────────────────────────────────────────────────────────────
  tools: {
    profile: "messaging",
    exec: {
      security: "deny",
      ask: "always",         // if exec is ever re-enabled, it still asks first
    },
    // Elevated exec runs OUTSIDE the sandbox — it punches straight through
    // containment. Off unless you have a specific, considered reason.
    elevated: { enabled: false },
    fs: { workspaceOnly: true },
    // Deny wins over allow everywhere, so this is the real floor.
    deny: [
      "group:automation",
      "group:runtime",
      "group:fs",
      "sessions_spawn",
      "sessions_send",
    ],
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Channels — Discord primary, locked to you
  // ─────────────────────────────────────────────────────────────────────────
  channels: {
    // Discord is an OFFICIAL PLUGIN, not core. Install it first, then restart:
    //   openclaw plugins install @openclaw/discord
    // Only iMessage, Telegram and WebChat ship in core.
    discord: {
      enabled: true,
      token: { source: "env", provider: "default", id: "DISCORD_BOT_TOKEN" },
      dmPolicy: "pairing",         // DM access needs an approval code
      groupPolicy: "allowlist",    // only servers listed below
      // There is no `linkPreviews` key. Discord's equivalent is
      // `suppressEmbeds`, which already defaults to true. (Telegram's
      // `linkPreview` defaults ON — that's the one that needs setting.)
      suppressEmbeds: true,
      guilds: {
        YOUR_SERVER_ID: {
          requireMention: false,   // fine on a private server that's only you
          users: ["YOUR_USER_ID"],
        },
      },
      // NOTE: also enable server > Privacy Settings > Direct Messages, or the
      // pairing code never arrives.
    },

    // Add in Phase 7 for work. Schema is mode + appToken + botToken — not a
    // single `token`. Socket mode suits a loopback-bound gateway.
    // slack: {
    //   enabled: true,
    //   mode: "socket",
    //   appToken: { source: "env", provider: "default", id: "SLACK_APP_TOKEN" },
    //   botToken: { source: "env", provider: "default", id: "SLACK_BOT_TOKEN" },
    //   dmPolicy: "allowlist",
    //   unfurlLinks: false,   // already defaults false
    //   unfurlMedia: false,
    // },
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Bindings — which agent handles which channel.
  // This is the real mechanism; `channels.<x>.agent` is NOT a config key and
  // is silently ignored. Matching runs by documented priority, most specific
  // first, so list narrow rules before broad ones.
  // ─────────────────────────────────────────────────────────────────────────
  bindings: [
    // Most specific first — matching runs by priority.
    // #code is the coding surface: messages there drive an OpenCode session
    // instead of talking to the assistant.
    {
      type: "acp",
      agentId: "opencode",
      match: {
        channel: "discord",
        peer: { kind: "channel", id: "YOUR_CODE_CHANNEL_ID" },
      },
      acp: { label: "opencode-main" },
    },
    { channel: "discord", agent: "main" },
    // { channel: "slack", agent: "dev" },   // work stays out of personal memory
  ],

  // ─────────────────────────────────────────────────────────────────────────
  // ACP — external coding harnesses
  //   openclaw plugins install @openclaw/acpx
  //   openclaw config set plugins.entries.acpx.enabled true
  //   /acp doctor
  // OpenCode itself must be installed and authenticated separately:
  //   brew install opencode      (or: curl -fsSL https://opencode.ai/install | bash)
  //   opencode           -> /connect, paste the OpenRouter key
  // ─────────────────────────────────────────────────────────────────────────
  acp: {
    enabled: true,
    dispatch: { enabled: true },
    // Allowlist. Anything not listed cannot be spawned, including by a
    // model that decides it would be convenient.
    allowedAgents: ["opencode"],
  },

  plugins: {
    entries: {
      acpx: {
        enabled: true,
        config: {
          // approve-all is only defensible because every session is confined
          // to a throwaway worktree on its own branch (worktree.sh). Point a
          // session at a live working copy with this set and it can rewrite
          // your repo unprompted.
          //
          // Non-interactive sessions cannot answer native permission prompts,
          // so "strict" effectively blocks cron- and phone-driven runs — that
          // is the real trade being made here.
          permissionMode: "approve-all",
        },
      },
    },
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Sessions
  // ─────────────────────────────────────────────────────────────────────────
  session: {
    dmScope: "per-channel-peer",   // don't merge conversations across peers
    reset: { mode: "idle", after: "12h" },
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Cron — jobs installed by cron-jobs.sh
  // ─────────────────────────────────────────────────────────────────────────
  cron: {
    enabled: true,
    sessionRetention: "24h",
    triggers: {
      // Leave OFF. Enabling permits headless script execution with the owning
      // agent's full tool policy, INCLUDING exec. See README Phase 6.2.
      enabled: false,
    },
  },

  // Heartbeat is configured under agents.defaults.heartbeat above — a
  // top-level `heartbeat` block is not read.

  // ─────────────────────────────────────────────────────────────────────────
  // Memory
  // ─────────────────────────────────────────────────────────────────────────
  memory: {
    search: {
      rememberAcrossConversations: true,
      // provider: set explicitly to use something other than the OpenAI default,
      // e.g. "ollama" for fully local embeddings.
    },
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Skills — treat third-party skills as untrusted code
  // ─────────────────────────────────────────────────────────────────────────
  skills: {
    entries: {
      // "email-triage": { enabled: true },
    },
  },

  security: {
    // installPolicy: "/usr/local/bin/vet-skill.sh",  // runs before installs proceed
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Hooks — inbound webhooks (CI, GitHub). Phase 7.
  // ─────────────────────────────────────────────────────────────────────────
  // hooks: {
  //   enabled: true,
  //   path: "/hooks",
  //   token: "SET_VIA_CLI",
  //   mappings: { "ci-failure": { agent: "dev", sessionKey: "ci" } },
  // },
}
