# LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sarvam AI (https://dashboard.sarvam.ai)
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx

# Agent behaviour
# IANA timezone for "today" / tool dates in the system prompt (default India)
AGENT_TIMEZONE=Asia/Kolkata
REENGAGE_AFTER_SECONDS=12
MAX_REENGAGE_ATTEMPTS=3
DISABLE_INTERRUPTIONS=false

# Observability
LOG_LEVEL=INFO
# Full recipient emails in booking logs (default: on). Set false to mask in logs.
# LOG_BOOKING_EMAIL_ADDRESSES=true

# Patel Dental Clinic (default). Override only if you rebrand the demo.
# CLINIC_NAME=Patel Dental Clinic

# Optional: Resend — real confirmation email after book_appointment (https://resend.com)
# Needs RESEND_API_KEY + BOOKING_EMAIL_FROM. Patient emails come from the tool (recipient_emails JSON array).
# BOOKING_EMAIL_TO — clinic / hardcoded inbox: merged into the first send; if that send fails, we retry here only.
# Without Resend configured, booking still works; confirmation_email=skipped_not_configured.
# RESEND_API_KEY=re_xxxxxxxx
# BOOKING_EMAIL_FROM=Patel Dental Clinic <onboarding@resend.dev>
# BOOKING_EMAIL_TO=staff@yourdomain.com

# Optional: serve_dev_ui.py (browser test UI on http://127.0.0.1:8765)
# DEV_UI_PORT=8765
# DEV_ROOM=test
# DEV_IDENTITY=user1

# SIP / Telephony — inbound phone calls via Twilio SIP trunk + LiveKit SIP service
# Requires: redis + livekit/sip in docker-compose; inbound trunk + dispatch rule via `lk` CLI.
# SIP_ENABLED=true
# TRANSFER_EMERGENCY_NUMBER=+919876543210
# TRANSFER_DOCTOR_NUMBERS={"dr_patel": "+919876543211", "dr_shah": "+919876543212"}
# SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
